<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    
    <t t-name="hr_recruitment_estevez.KpisGrid" owl="1">
        <!-- 6 tarjetas del mismo tamaño, mismo estilo que el dashboard de Empleados -->
        <div class="container-fluid p-2">
            <div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3">
                <t t-foreach="kpis" t-as="kpi" t-key="kpi.name">
                    <div class="col">
                        <KpiCard
                            name="kpi.name"
                            value="kpi.value"
                            icon="kpi.icon"
                            color="kpi.color"
                            subtitle="kpi.subtitle"
                            tooltip="kpi.tooltip"
                            onClick="kpi.onClick"
                            isLoading="state.isLoading"/>
                    </div>
                </t>
            </div>
        </div>

        <PostulationsDetailModal t-if="state.showModal"
                                 startDate="props.startDate"
                                 endDate="props.endDate"
                                 actionService="actionService"
                                 onClose="() => this.closeModal()"/>
    </t>

</templates>