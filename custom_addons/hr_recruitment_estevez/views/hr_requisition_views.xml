<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vista de lista para requisiciones -->
    <record id="view_hr_requisition_list" model="ir.ui.view">
        <field name="name">hr.requisition.list</field>
        <field name="model">hr.requisition</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'rejected'">
                <field name="folio" string="Folio" width="120"/>
                <field name="create_date" string="Fecha de Solicitud" widget="date" width="120"/>
                <field name="workstation_job_id" width="180"/>
                <field name="tag_ids" widget="many2many_tags" string="Etiquetas" optional="show" width="180"/>
                <field name="workstation_area_id" string="Departamento" optional="show" width="160"/>
                <field name="workstation_department_id" string="Área" optional="show" width="160"/>
                <field name="number_of_vacancies" string="N° Vacantes" optional="show" width="100"/>
                <field name="requestor_id" widget="many2one_avatar_user" optional="show" width="180"/>
                <field name="company_id" optional="hide" width="180"/>
                <field name="requisition_type" optional="hide"/>
                <field name="project_id" string="Proyecto" optional="show" width="160"/>
                <field name="pending_approver_id" widget="many2one_avatar_user" optional="show" width="180"/>
                <field name="state" string="Estado Requisición" width="160"
                       widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-warning="state in ('to_approve', 'first_approval')"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <field name="publication_status" string="Estado Vacante" width="140"
                       widget="badge"
                       decoration-success="publication_status == 'Abierta'"
                       decoration-danger="publication_status == 'Cerrada'"
                       decoration-warning="publication_status == 'Por Abrir'"
                       decoration-muted="publication_status == 'No aplica'"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario para requisiciones -->
    <record id="view_hr_requisition_form" model="ir.ui.view">
        <field name="name">hr.requisition.form</field>
        <field name="model">hr.requisition</field>
        <field name="arch" type="xml">
            <form class="o_estevez_requisition_form">
                <header>
                    <!-- Aprobaciones: solo las ve quien debe aprobar -->
                    <button name="action_approve" string="Aprobar" type="object" class="btn-primary" icon="fa-check"
                            invisible="state != 'to_approve' or not is_current_approver"
                            confirm="¿Aprobar esta requisición? Pasará a la aprobación final."/>
                    <button name="action_confirm_approve" string="Aprobación final" type="object" class="btn-primary" icon="fa-check"
                            invisible="state != 'first_approval' or not is_current_approver"
                            confirm="¿Dar la aprobación final a esta requisición?"/>
                    <button name="action_reject" string="Rechazar" type="object" class="btn-danger" icon="fa-times"
                            invisible="state not in ('to_approve', 'first_approval') or not is_current_approver"/>

                    <!-- Vacante (Talento Humano) -->
                    <button name="action_publish_vacancy" type="object" string="Aperturar Vacante" class="btn-primary" icon="fa-bullhorn"
                            groups="hr_recruitment.group_hr_recruitment_user"
                            invisible="state != 'approved' or is_published"/>
                    <button name="action_close_vacancy" type="object" string="Cerrar Vacante" class="btn-secondary" icon="fa-lock"
                            groups="hr_recruitment.group_hr_recruitment_user"
                            invisible="state != 'approved' or not is_published"
                            confirm="¿Cerrar la vacante? Dejará de estar publicada."/>

                    <!-- Corregir: el solicitante (o Talento Humano) si fue rechazada; solo Talento Humano si ya estaba aprobada -->
                    <button name="action_reset_to_draft" string="Corregir y reenviar" type="object" class="btn-secondary" icon="fa-pencil"
                            invisible="state != 'rejected' or not is_requestor"/>
                    <button name="action_reset_to_draft" string="Regresar a Borrador" type="object" class="btn-secondary" icon="fa-undo"
                            groups="hr_recruitment.group_hr_recruitment_manager"
                            invisible="state not in ('rejected', 'approved') or (state == 'rejected' and is_requestor)"
                            confirm="La requisición regresará a Borrador y tendrá que aprobarse de nuevo. Si la vacante está publicada, se cerrará. ¿Continuar?"/>

                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,first_approval,approved"/>
                </header>

                <sheet>
                    <field name="is_current_approver" invisible="1"/>
                    <field name="is_requestor" invisible="1"/>
                    <field name="is_published" invisible="1"/>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <div class="o_estevez_req_badges">
                            <span class="badge rounded-pill text-bg-secondary">
                                <i class="fa fa-file-text-o me-1"/>Formato <field name="requisition_number" readonly="1" class="d-inline"/>
                            </span>
                            <span class="badge rounded-pill text-bg-success" invisible="publication_status != 'Abierta'">
                                <i class="fa fa-bullhorn me-1"/>Vacante abierta
                            </span>
                            <span class="badge rounded-pill text-bg-dark" invisible="publication_status != 'Cerrada'">
                                <i class="fa fa-lock me-1"/>Vacante cerrada
                            </span>
                        </div>
                    </div>

                    <!-- Avisos según el estado -->
                    <div class="alert alert-info o_estevez_req_alert" role="status" invisible="state not in ('to_approve', 'first_approval')">
                        <i class="fa fa-hourglass-half"/>
                        <div>
                            <strong invisible="state != 'to_approve'">Esperando la aprobación de Dirección</strong>
                            <strong invisible="state != 'first_approval'">Esperando la aprobación final</strong>
                            <div invisible="not pending_approver_id">Debe aprobarla: <field name="pending_approver_id" readonly="1" class="d-inline fw-bold" options="{'no_open': True}"/></div>
                            <div invisible="pending_approver_id">No hay aprobador configurado en la Dirección; la aprueba Talento Humano.</div>
                        </div>
                    </div>
                    <div class="alert alert-danger o_estevez_req_alert" role="alert" invisible="state != 'rejected'">
                        <i class="fa fa-times-circle"/>
                        <div>
                            <strong>Rechazada por <field name="rejected_by_id" readonly="1" class="d-inline" options="{'no_open': True}"/></strong>
                            <div><field name="rejection_reason" readonly="1"/></div>
                            <div class="small mt-1" invisible="not is_requestor">Corrígela con <b>Corregir y reenviar</b> y vuelve a enviarla.</div>
                        </div>
                    </div>
                    <div class="alert alert-success o_estevez_req_alert" role="status" invisible="state != 'approved' or is_published">
                        <i class="fa fa-check-circle"/>
                        <div>
                            <strong>Requisición aprobada</strong>
                            <div>Talento Humano ya puede aperturar la vacante.</div>
                        </div>
                    </div>

                    <!-- Pasos (solo al capturar en Borrador; se puede dar clic en cada paso) -->
                    <div class="o_estevez_req_steps" invisible="state != 'draft'">
                        <div class="o_estevez_req_step o_active" invisible="wizard_step != 'especificaciones'">
                            <span class="o_estevez_req_step_num">1</span><span>Especificaciones</span>
                        </div>
                        <button name="action_go_to_step" type="object" class="o_estevez_req_step" context="{'wizard_step': 'especificaciones'}"
                                invisible="wizard_step == 'especificaciones'">
                            <span class="o_estevez_req_step_num">1</span><span>Especificaciones</span>
                        </button>
                        <div class="o_estevez_req_step_line"/>
                        <div class="o_estevez_req_step o_active" invisible="wizard_step != 'datos_puesto'">
                            <span class="o_estevez_req_step_num">2</span><span>Puesto y perfil</span>
                        </div>
                        <button name="action_go_to_step" type="object" class="o_estevez_req_step" context="{'wizard_step': 'datos_puesto'}"
                                invisible="wizard_step == 'datos_puesto'">
                            <span class="o_estevez_req_step_num">2</span><span>Puesto y perfil</span>
                        </button>
                        <div class="o_estevez_req_step_line"/>
                        <div class="o_estevez_req_step o_active" invisible="wizard_step != 'equipo'">
                            <span class="o_estevez_req_step_num">3</span><span>Equipo y observaciones</span>
                        </div>
                        <button name="action_go_to_step" type="object" class="o_estevez_req_step" context="{'wizard_step': 'equipo'}"
                                invisible="wizard_step == 'equipo'">
                            <span class="o_estevez_req_step_num">3</span><span>Equipo y observaciones</span>
                        </button>
                    </div>

                    <group string="Datos del Solicitante">
                        <group>
                            <field name="requestor_id" options="{'no_open': True}"/>
                            <field name="company_id" options="{'no_open': True}"/>
                            <field name="job_id" options="{'no_open': True}"/>
                        </group>
                        <group>
                            <field name="direction_id" options="{'no_open': True}"/>
                            <field name="department_id" options="{'no_open': True}"/>
                        </group>
                    </group>

                    <!-- Paso 1: Especificaciones -->
                    <group string="Especificaciones de Requisición" invisible="state == 'draft' and wizard_step != 'especificaciones'">
                        <group>
                            <field name="requisition_type" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="state != 'draft'"
                                   invisible="requisition_type != 'replacement'" required="requisition_type == 'replacement'"
                                   options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="vacancy_reason" readonly="state != 'draft'" invisible="requisition_type != 'new_vacancy'"/>
                            <field name="other_reason_description" readonly="state != 'draft'" invisible="vacancy_reason != 'other'"/>
                        </group>
                    </group>

                    <!-- Paso 2: Puesto y perfil -->
                    <group invisible="state == 'draft' and wizard_step != 'datos_puesto'">
                        <group string="Puesto solicitado">
                            <field name="job_type" readonly="state != 'draft'"/>
                            <field name="workstation_direction_id" readonly="state != 'draft'" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="workstation_department_id" readonly="state != 'draft'" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="workstation_area_id" readonly="state != 'draft'" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="workstation_job_id" readonly="state != 'draft'" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="number_of_vacancies" readonly="state != 'draft'"/>
                            <field name="project_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="work_schedule" readonly="state != 'draft'" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                        </group>
                        <group string="Perfil del candidato">
                            <field name="gender" readonly="state != 'draft'"/>
                            <label for="age_range_min" string="Rango de edad"/>
                            <div class="o_row o_estevez_req_age">
                                <span>De</span>
                                <field name="age_range_min" nolabel="1" readonly="state != 'draft'"/>
                                <span>a</span>
                                <field name="age_range_max" nolabel="1" readonly="state != 'draft'"/>
                                <span>años</span>
                            </div>
                            <field name="year_of_experience" readonly="state != 'draft'"/>
                            <field name="academic_degree_id" readonly="state != 'draft'" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            <field name="software_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                            <field name="general_functions" readonly="state != 'draft'" placeholder="Principales tareas y responsabilidades del puesto"/>
                        </group>
                    </group>

                    <!-- Paso 3: Equipo y observaciones -->
                    <group invisible="state == 'draft' and wizard_step != 'equipo'">
                        <group string="Equipo requerido">
                            <field name="computer_equipment_required" readonly="state != 'draft'"/>
                            <field name="cellular_equipment_required" readonly="state != 'draft'"/>
                            <field name="uniform_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                            <field name="epp_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                        </group>
                        <group string="Observaciones">
                            <field name="tag_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                            <field name="observations" readonly="state != 'draft'" placeholder="Comentarios adicionales sobre la vacante"/>
                        </group>
                    </group>

                    <!-- Seguimiento de aprobaciones -->
                    <group string="Seguimiento" invisible="state == 'draft'">
                        <group>
                            <field name="folio"/>
                            <field name="submit_date"/>
                        </group>
                        <group>
                            <field name="first_approver_id" invisible="not first_approver_id" options="{'no_open': True}"/>
                            <field name="first_approval_date" invisible="not first_approval_date"/>
                            <field name="final_approver_id" invisible="not final_approver_id" options="{'no_open': True}"/>
                            <field name="final_approval_date" invisible="not final_approval_date"/>
                            <field name="publish_date" invisible="not publish_date"/>
                            <field name="close_date" invisible="not close_date"/>
                        </group>
                    </group>

                    <!-- Navegación del asistente -->
                    <div class="o_estevez_req_nav" invisible="state != 'draft'">
                        <button name="action_previous" type="object" string="Anterior" class="btn-secondary" icon="fa-chevron-left"
                                invisible="wizard_step == 'especificaciones'"/>
                        <span class="o_estevez_req_nav_info">
                            <span invisible="wizard_step != 'especificaciones'">Paso 1 de 3</span>
                            <span invisible="wizard_step != 'datos_puesto'">Paso 2 de 3</span>
                            <span invisible="wizard_step != 'equipo'">Paso 3 de 3</span>
                        </span>
                        <button name="action_next" type="object" string="Siguiente" class="btn-primary"
                                invisible="wizard_step == 'equipo'"/>
                        <button name="action_submit" type="object" string="Enviar a aprobación" class="btn-primary" icon="fa-paper-plane"
                                invisible="wizard_step != 'equipo'"
                                confirm="¿Enviar la requisición a aprobación? Ya no podrás editarla mientras se revisa."/>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Ventana de rechazo -->
    <record id="view_hr_requisition_reject_wizard_form" model="ir.ui.view">
        <field name="name">hr.requisition.reject.wizard.form</field>
        <field name="model">hr.requisition.reject.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="requisition_id" invisible="1"/>
                <p class="text-muted">El solicitante recibirá el motivo y podrá corregir la requisición para volver a enviarla.</p>
                <field name="reason" placeholder="Explica por qué se rechaza la requisición..." nolabel="1"/>
                <footer>
                    <button name="action_confirm" type="object" string="Rechazar" class="btn-danger"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Vista de search para requisiciones -->
    <record id="hr_requisition_search" model="ir.ui.view">
        <field name="name">hr.requisition.search</field>
        <field name="model">hr.requisition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Requisición" filter_domain="['|', ('folio', 'ilike', self), ('workstation_job_id', 'ilike', self)]"/>
                <field name="requestor_id"/>
                <field name="workstation_direction_id"/>
                <field name="workstation_department_id"/>
                <field name="workstation_area_id"/>
                <field name="project_id" string="Proyecto"/>
                <field name="publication_status"/>

                <filter name="filter_mine" string="Mis requisiciones" domain="[('requestor_id', '=', uid)]"/>
                <separator/>
                <filter name="state_draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_pending" string="En aprobación" domain="[('state', 'in', ('to_approve', 'first_approval'))]"/>
                <filter name="state_approved" string="Aprobadas" domain="[('state', '=', 'approved')]"/>
                <filter name="state_rejected" string="Rechazadas" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="filter_open_positions" string="Vacante abierta" domain="[('state', '=', 'approved'), ('is_published', '=', True)]"/>
                <filter name="filter_closed_positions" string="Vacante cerrada" domain="[('state', '=', 'approved'), ('is_published', '=', False)]"/>
                <separator/>
                <filter name="filter_proj_sinproyecto" string="Sin proyecto" domain="[('project_id', '=', False)]"/>
                <filter name="last_month" string="Último mes" domain="[('create_date', '>=', (context_today() - relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>

                <group expand="0" string="Agrupar por">
                    <filter name="group_by_state" string="Estado requisición" context="{'group_by': 'state'}"/>
                    <filter name="group_by_requestor" string="Solicitante" context="{'group_by': 'requestor_id'}"/>
                    <filter name="group_by_direction" string="Dirección" context="{'group_by': 'workstation_direction_id'}"/>
                    <filter name="group_by_department" string="Área" context="{'group_by': 'workstation_department_id'}"/>
                    <filter name="group_by_area" string="Departamento" context="{'group_by': 'workstation_area_id'}"/>
                    <filter name="group_by_project" string="Proyecto" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
