<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_estevez.KpisGrid" owl="1">
        <div class="container-fluid p-2">
            <!-- 6 KPIs del mismo tamaño: 2 por fila en móvil, 3 en tablet, 6 en escritorio -->
            <div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3">
                <t t-foreach="kpis" t-as="kpi" t-key="kpi_index">
                    <div class="col">
                        <!-- KPI con gráfica (solo Total Empleados) -->
                        <KpiChartCard
                            t-if="kpi.showChart"
                            value="kpi.value"
                            label="kpi.name"
                            icon="kpi.icon"
                            color="kpi.color"
                            subtitle="kpi.subtitle"
                            tooltip="kpi.tooltip"
                            series="kpi.series"
                            labels="kpi.labels"
                            onClick="kpi.onClick"
                            onPointClick="kpi.onPointClick"
                            isLoading="state.isLoading"
                        />
                        <!-- KPI normal (todos los demás) -->
                        <KpiCard
                            t-else=""
                            name="kpi.name"
                            value="kpi.value"
                            icon="kpi.icon"
                            color="kpi.color"
                            subtitle="kpi.subtitle"
                            tooltip="kpi.tooltip"
                            onClick="kpi.onClick"
                            isLoading="state.isLoading"
                        />
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
