<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_estevez.KpiChartCard" owl="1">
        <div t-attf-class="o_hr_kpi_card card h-100 shadow-sm rounded-3 o_hr_kpi_{{ props.color or 'primary' }} {{ hasClick ? 'o_hr_kpi_clickable' : '' }}"
            t-att-title="props.tooltip"
            t-att-role="hasClick ? 'button' : null"
            t-att-tabindex="hasClick ? 0 : null"
            t-on-click="onCardClick"
            t-on-keydown="onCardKeydown">
            <div class="card-body d-flex flex-column p-3">
                <!-- Encabezado: icono + indicador de detalle -->
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <span class="o_hr_kpi_icon d-inline-flex align-items-center justify-content-center rounded-circle">
                        <i t-attf-class="fa {{ props.icon or 'fa-bar-chart' }}" aria-hidden="true"/>
                    </span>
                    <i t-if="hasClick" class="fa fa-arrow-right o_hr_kpi_arrow" aria-hidden="true"/>
                </div>

                <!-- Cargando -->
                <div t-if="props.isLoading" class="placeholder-glow flex-grow-1">
                    <span class="placeholder col-6 placeholder-lg mb-2"/>
                    <span class="placeholder col-9"/>
                </div>

                <!-- Contenido -->
                <t t-else="">
                    <div class="o_hr_kpi_value fw-bold lh-1 mb-1" t-esc="formattedValue"/>
                    <div class="o_hr_kpi_label fw-semibold" t-esc="props.label"/>
                </t>

                <!-- Sparkline en el pie, a la altura del texto de contexto de las demás tarjetas -->
                <div class="mt-auto pt-1">
                    <div t-ref="chart" class="o_hr_kpi_sparkline"/>
                    <div t-if="props.subtitle and !props.isLoading" class="small text-muted text-truncate" t-esc="props.subtitle"/>
                </div>
            </div>
        </div>
    </t>
</templates>
