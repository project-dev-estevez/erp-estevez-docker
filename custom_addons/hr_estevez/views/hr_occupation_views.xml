<odoo>
    <data>

        <record id="view_hr_occupation_list_config" model="ir.ui.view">
            <field name="name">hr.occupation.list.config</field>
            <field name="model">hr.occupation</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <list string="Ocupaciones">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="employee_count"/>
                </list>
            </field>
        </record>

        <record id="view_hr_occupation_form_config" model="ir.ui.view">
            <field name="name">hr.occupation.form.config</field>
            <field name="model">hr.occupation</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <form string="Ocupación">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_employees" type="object" class="oe_stat_button" icon="fa-users">
                                <field name="employee_count" widget="statinfo" string="Empleados"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="code" placeholder="e.g. 825080301"/>
                                <field name="name" placeholder="e.g. Administrador"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_occupation_search_config" model="ir.ui.view">
            <field name="name">hr.occupation.search.config</field>
            <field name="model">hr.occupation</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" string="Ocupación" filter_domain="['|', ('code', 'ilike', self), ('name', 'ilike', self)]"/>
                    <field name="code"/>
                </search>
            </field>
        </record>

        <record id="action_hr_occupation_config" model="ir.actions.act_window">
            <field name="name">Ocupaciones</field>
            <field name="res_model">hr.occupation</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_hr_occupation_search_config"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Crea una nueva ocupación</p>
                <p>Las ocupaciones aparecen como opciones en la ficha del empleado.</p>
            </field>
        </record>

        <menuitem id="menu_hr_occupation_config"
                  name="Ocupaciones"
                  action="action_hr_occupation_config"
                  parent="hr.menu_config_employee"
                  sequence="8"
                  groups="hr.group_hr_user"/>

    </data>
</odoo>
