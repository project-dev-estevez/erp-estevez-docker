<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_employees_kanban_inherit" model="ir.ui.view">
            <field name="name">hr.employee.kanban.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
            <field name="arch" type="xml">

                <!-- Nombre y punto de presencia en flex: con nombres largos el punto
                     ya no se baja de renglón ni deja un hueco antes del puesto -->
                <xpath expr="//main/div[field[@name='name']]" position="replace">
                    <div class="d-flex align-items-start gap-2">
                        <field class="fw-bold fs-5 flex-grow-1 text-break" name="name" placeholder="Employee's Name"/>
                        <div t-if="record.show_hr_icon_display.raw_value" class="flex-shrink-0">
                            <field name="hr_icon_display" class="o_employee_availability" widget="hr_presence_status" />
                        </div>
                    </div>
                </xpath>

                <!-- Puesto en gris para separarlo visualmente del nombre y los datos de contacto -->
                <xpath expr="//field[@name='job_title']" position="attributes">
                    <attribute name="class">text-muted</attribute>
                </xpath>

                <!-- Para el email - buscar el div que tiene el atributo t-if -->
                <xpath expr="//div[@t-if='record.work_email.raw_value']" position="replace">
                    <div t-if="record.work_email.raw_value or record.private_email.raw_value" class="o_text_overflow">
                        <i class="fa fa-fw me-2 fa-envelope text-primary" title="Email"/>
                        <t t-if="record.work_email.raw_value">
                            <field name="work_email"/>
                        </t>
                        <t t-elif="record.private_email.raw_value">
                            <field name="private_email"/>
                        </t>
                    </div>
                </xpath>
                
                <!-- Para el teléfono - buscar el div que tiene el atributo t-if -->
                <xpath expr="//div[@t-if='record.work_phone.raw_value']" position="replace">
                    <div t-if="record.work_phone.raw_value or record.private_phone.raw_value">
                        <i class="fa fa-fw me-2 fa-phone text-primary" title="Phone"/>
                        <t t-if="record.work_phone.raw_value">
                            <field name="work_phone"/>
                        </t>
                        <t t-elif="record.private_phone.raw_value">
                            <field name="private_phone"/>
                        </t>
                    </div>
                </xpath>
                
            </field>
        </record>
    </data>
</odoo>