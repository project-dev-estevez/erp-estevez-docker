<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Formulario de contratos -->
    <record id="view_hr_contract_form_inherit" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">           
                    
            <!-- Add a new "Guardar" button in the header -->
            <xpath expr="//header" position="inside">
                <button type="object"
                        string="Guardar"
                        class="btn-primary"
                        icon="fa-save"
                        name="action_save"/>

                <button name="action_download_addendum_docx"
                        type="object"
                        string="Addendum"
                        class="btn-primary"
                        icon="fa-file-word-o"/>

                <button name="action_download_contract_docx"
                        type="object"
                    string="Generar Contrato"
                        class="btn-primary"
                        icon="fa-file-word-o"/>

                <button type="object"
                        string="Cancelar Contrato"
                        class="btn-danger"
                        icon="fa-ban"
                        name="action_cancel_contract"
                        confirm="¿Está seguro de que desea cancelar el contrato actual?"
                        invisible="state == 'cancel'"/>
            </xpath>

            <!-- Formulario más claro: avisos, título con insignias y secciones con encabezado -->
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_estevez_contract_form" separator=" "/>
            </xpath>

            <xpath expr="//widget[@name='web_ribbon']" position="after">
                <widget name="web_ribbon" title="Cancelado" bg_color="text-bg-danger" invisible="state != 'cancel' or not active"/>
                <widget name="web_ribbon" title="Vencido" bg_color="text-bg-warning" invisible="state != 'close' or not active"/>
            </xpath>

            <xpath expr="//div[@name='title']" position="replace">
                <div class="o_estevez_contract_title" name="title">
                    <h1><field name="name" placeholder="Nombre del contrato"/></h1>
                    <div class="o_estevez_contract_badges">
                        <span class="badge rounded-pill text-bg-info" invisible="name != 'Contrato Inicial'">
                            <i class="fa fa-flag-o me-1"/>Primer contrato
                        </span>
                        <span class="badge rounded-pill text-bg-success" invisible="name != 'Contrato Final'">
                            <i class="fa fa-check-circle me-1"/>Contrato final · indeterminado
                        </span>
                    </div>
                </div>

                <!-- Avisos según el estado del contrato -->
                <div class="alert alert-warning o_estevez_contract_alert" role="alert" invisible="state != 'close'">
                    <i class="fa fa-exclamation-triangle"/>
                    <div>
                        <strong>Este contrato ya venció.</strong>
                        Para renovarlo, cancélalo con <strong>Cancelar Contrato</strong> y después crea el nuevo con <strong>Nuevo</strong>.
                    </div>
                </div>
                <div class="alert alert-info o_estevez_contract_alert" role="alert"
                     invisible="state != 'open' or not date_end or days_to_expiry &gt; 15 or days_to_expiry &lt; 0">
                    <i class="fa fa-hourglass-half"/>
                    <div>
                        <strong>Este contrato vence pronto</strong> (le quedan <field name="days_to_expiry" class="d-inline fw-bold"/> días).
                        Para renovarlo, cancélalo y crea el nuevo.
                    </div>
                </div>
                <div class="alert alert-secondary o_estevez_contract_alert" role="alert" invisible="state != 'cancel'">
                    <i class="fa fa-ban"/>
                    <div><strong>Contrato cancelado.</strong> Ya se puede crear un contrato nuevo para este empleado.</div>
                </div>
            </xpath>

            <!-- Columna de la izquierda: datos del contrato -->
            <xpath expr="//group/group[@name='top_info_left']" position="replace">
                <group string="Datos del contrato" name="top_info_left">
                    <field name="active" invisible="1"/>
                    <field name="employee_id" widget="many2one_avatar_employee" readonly="True" options="{'no_create': True}"/>
                    <field name="active_employee" invisible="1"/>
                    <field name="company_id" options="{'no_create': True}"/>
                    <field name="contract_type_id" groups="!hr_contract.group_hr_contract_manager" options="{'no_open': True, 'no_create': True}"
                           placeholder="Determinado o indeterminado"/>
                    <field name="contract_type_id" groups="hr_contract.group_hr_contract_manager" options="{'no_create': True}"
                           placeholder="Determinado o indeterminado"/>
                    <!-- Fecha de ingreso a la empresa -->
                    <field name="date_of_entry"/>
                    <field name="bank" invisible="1"/>
                    <field name="bank_account" invisible="1"/>
                    <field name="clabe" invisible="1"/>
                </group>
            </xpath>

            <!-- Columna de la derecha: vigencia -->
            <xpath expr="//group/group[@name='top_info_right']" position="replace">
                <group string="Vigencia" name="top_info_right">
                    <field name="date_start" string="Fecha Inicio de Contrato"/>
                    <field name="contract_duration" string="Duración del Contrato" placeholder="Selecciona la duración"/>
                    <field name="date_end" string="Fecha Fin de Contrato" placeholder="Sin fecha de fin"/>
                    <field name="days_to_expiry" invisible="not date_end or state == 'cancel'"
                           decoration-danger="days_to_expiry &lt; 0" decoration-warning="days_to_expiry &gt;= 0 and days_to_expiry &lt;= 15"
                           decoration-success="days_to_expiry &gt; 15"/>
                    <field name="hr_responsible_id" widget="many2one_avatar_user" invisible="1"/>
                </group>
            </xpath>

            <!-- Puesto y adscripción (se llenan solos con los datos del empleado) -->
            <xpath expr="//group[@name='top_info']" position="after">
                <group string="Puesto y adscripción" name="estevez_position" class="o_estevez_contract_position">
                    <group>
                        <field name="job_id" groups="!hr_contract.group_hr_contract_manager" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                        <field name="job_id" groups="hr_contract.group_hr_contract_manager" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                        <field name="work_direction" readonly="1"/>
                        <field name="department_id" groups="!hr_contract.group_hr_contract_manager" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                        <field name="department_id" groups="hr_contract.group_hr_contract_manager" readonly="1" options="{'no_open': True, 'no_create': True, 'no_create_edit': True}"/>
                    </group>
                    <group>
                        <field name="work_area" readonly="1"/>
                        <field name="work_location" readonly="1"/>
                        <field name="payroll_type" readonly="1"/>
                    </group>
                </group>
            </xpath>

            <!-- Hide Salary Information page -->
            <xpath expr="//notebook/page[@name='information']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Nuevas páginas -->
            <xpath expr="//notebook/page[@name='other']" position="before">
                <page name="documents" string="Contrato firmado">
                    <div class="o_estevez_contract_doc" invisible="document_file">
                        <i class="fa fa-cloud-upload"/>
                        <h5>Aún no se adjunta el contrato firmado</h5>
                        <p class="text-muted">Genéralo con <strong>Generar Contrato</strong>, fírmalo y súbelo aquí.</p>
                        <field name="document_file" filename="document_filename" widget="binary" string="Adjuntar Archivo"/>
                    </div>
                    <div class="o_estevez_contract_doc o_estevez_contract_doc_done" invisible="not document_file">
                        <i class="fa fa-check-circle"/>
                        <h5>Contrato firmado adjunto</h5>
                        <field name="document_file" filename="document_filename" widget="binary" string="Adjuntar Archivo"/>
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <!-- Listado de contratos -->
    <record id="view_hr_contract_list_inherit" model="ir.ui.view">
        <field name="name">hr.contract.tree.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_tree"/>
        <field name="arch" type="xml">       
            <field name="employee_id" position="attributes">
                <attribute name="width">200</attribute>
            </field>
            <field name="name" position="attributes">
                <attribute name="width">200</attribute>
            </field>
            <field name="department_id" position="attributes">
                <attribute name="width">300</attribute>
            </field>
            <field name="job_id" position="attributes">
                <attribute name="width">200</attribute>
            </field>
            <field name="date_start" position="attributes">
                <attribute name="width">200</attribute>
            </field>                
            <field name="date_end" position="attributes">
                <attribute name="width">200</attribute>
            </field>
            <field name="contract_type_id" position="attributes">
                <attribute name="width">150</attribute>
            </field>
            <field name="wage" position="attributes">
                <attribute name="width">150</attribute>
            </field>
            <field name="resource_calendar_id" position="attributes">
                <attribute name="width">200</attribute>
            </field>
            <!--field name="structure_type_id" position="attributes">
                <attribute name="width">200</attribute>
            </field-->
            <field name="company_id" position="attributes">
                <attribute name="width">200</attribute>
            </field>
            <xpath expr="//field[@name='date_start']" position="after">
                <field name="create_date" string="Fecha de Creación" optional="hide" width="200"/>
                <field name="days_to_expiry" string="Días Vencimiento" optional="hide" width="150"/>
                <field name="create_uid" string="Creado por" widget="many2one_avatar_user" optional="hide" width="200"/>
            </xpath>                                            
        </field>
    </record>

    <!-- Acción contratos SIN cancelados -->
    <record id="hr_contract.action_hr_contract" model="ir.actions.act_window">
        <field name="domain">[('state', '!=', 'cancel')]</field>
    </record>

    <!-- Vista de búsqueda corregida -->
    <record id="view_hr_contract_search_inherit_remove_cancel" model="ir.ui.view">
        <field name="name">hr.contract.search.inherit.remove.cancel</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_search"/>
        <field name="arch" type="xml">
            <!-- Agregar filtro para Vencido (solo Determinado) -->
            <xpath expr="//search" position="inside">
                <filter name="vencido" string="Vencido"
                        domain="[('state','=','close'), ('contract_type_id.name','=','Determinado')]"/>
                
                <filter name="hide_cancel"
                        string="Excluir cancelados"
                        domain="[('state','!=','cancel')]"
                        invisible="1"/>
            </xpath>           
        </field>
    </record>
</odoo>