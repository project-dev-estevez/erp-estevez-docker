@@ -0,0 +1,62 @@
+import re
+
+from odoo import api, fields, models
+
+LOGIN_PAGE_DESIGNS = [
+    ("fullscreen_right", "Fullscreen Right"),
+    ("fullscreen_left", "Fullscreen Left"),
+    ("boxed_left", "Boxed Left"),
+    ("boxed_right", "Boxed Right"),
+    ("boxed_center", "Boxed Center"),
+]
+DEFAULT_LOGIN_PAGE_DESIGN = "fullscreen_left"
+DEFAULT_MOTTO_TEXT_COLOR = "#000000"
+HEX_COLOR = re.compile(r"^#(?:[0-9a-fA-F]{3}){1,2}$")
+
+
+class ResCompany(models.Model):
+    _inherit = 'res.company'
+
+    login_page_design = fields.Selection(
+        string="Login Page Design",
+        selection=LOGIN_PAGE_DESIGNS,
+        default=DEFAULT_LOGIN_PAGE_DESIGN,
+        help="Elige el estilo de diseño para la página de inicio de sesión",
+    )
+    login_page_custom_background = fields.Boolean(string="Login Page Custom Background")
+    login_page_background_image = fields.Image(string="Login Page Background Image")
+    login_page_logo = fields.Image(string="Login Page Logo")
+    login_page_show_motto = fields.Boolean(string="Show Motto")
+    login_page_motto_text = fields.Char(string="Motto Text")
+    login_page_motto_author = fields.Char(string="Motto Author")
+    login_page_motto_text_color = fields.Char(
+        string="Motto Text Color",
+        default=DEFAULT_MOTTO_TEXT_COLOR,
+    )
+
+    @api.model
+    def _get_login_page_company(self, uid=None):
+        """Compañía cuya configuración se muestra en las pantallas de acceso:
+        la del usuario con sesión o, sin sesión, la compañía principal."""
+        if uid:
+            return self.env['res.users'].sudo().browse(uid).company_id
+        return (
+            self.env.ref('base.main_company', raise_if_not_found=False)
+            or self.sudo().search([], limit=1)
+        )
+
+    def _get_login_page_values(self):
+        """Valores que reciben las plantillas de acceso, con valores por defecto
+        resueltos y entradas saneadas."""
+        self.ensure_one()
+        valid_designs = dict(LOGIN_PAGE_DESIGNS)
+        design = self.login_page_design
+        color = self.login_page_motto_text_color
+        return {
+            'login_page_design': design if design in valid_designs else DEFAULT_LOGIN_PAGE_DESIGN,
+            'login_page_custom_background': self.login_page_custom_background,
+            'login_page_show_motto': self.login_page_show_motto,
+            'login_page_motto_text': self.login_page_motto_text,
+            'login_page_motto_author': self.login_page_motto_author,
+            'login_page_motto_text_color': color if color and HEX_COLOR.match(color) else DEFAULT_MOTTO_TEXT_COLOR,
+        }
