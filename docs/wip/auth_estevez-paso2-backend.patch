@@ -0,0 +1,45 @@
+"""Mueve la configuración de la página de acceso de ir.config_parameter
+(auth_estevez.*) a los campos de res.company (docs/spec.md, D6 y AUTH-18)."""
+import logging
+
+from odoo import SUPERUSER_ID, api
+
+from odoo.addons.auth_estevez.models.res_company import LOGIN_PAGE_DESIGNS
+
+_logger = logging.getLogger(__name__)
+
+PARAM_PREFIX = 'auth_estevez.'
+BOOLEAN_FIELDS = {'login_page_custom_background', 'login_page_show_motto'}
+FIELDS = (
+    'login_page_design',
+    'login_page_custom_background',
+    'login_page_background_image',
+    'login_page_logo',
+    'login_page_show_motto',
+    'login_page_motto_text',
+    'login_page_motto_author',
+    'login_page_motto_text_color',
+)
+
+
+def _convert(field_name, raw_value):
+    if field_name in BOOLEAN_FIELDS:
+        return raw_value in ('True', 'true', '1')
+    return raw_value
+
+
+def migrate(cr, version):
+    env = api.Environment(cr, SUPERUSER_ID, {})
+    legacy_params = env['ir.config_parameter'].search([('key', '=like', f'{PARAM_PREFIX}%')])
+    if not legacy_params:
+        return
+
+    stored = {param.key.removeprefix(PARAM_PREFIX): param.value for param in legacy_params}
+    values = {name: _convert(name, stored[name]) for name in FIELDS if name in stored}
+    if values.get('login_page_design') not in dict(LOGIN_PAGE_DESIGNS):
+        values.pop('login_page_design', None)
+
+    company = env['res.company']._get_login_page_company()
+    company.write(values)
+    legacy_params.unlink()
+    _logger.info("auth_estevez: %s parámetros migrados a %s", len(values), company.display_name)
